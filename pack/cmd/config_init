#!/bin/bash
# Validate the port before the config change is applied.
set -u

PORT="${wizard_port:-}"
if [ -z "${PORT}" ]; then
    echo "请填写 S3 TCP 端口。" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi
case "${PORT}" in
    *[!0-9]*)
        echo "S3 端口只能包含数字。" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
        exit 1
        ;;
esac
if [ "${PORT}" -lt 1024 ] || [ "${PORT}" -gt 65535 ]; then
    echo "S3 端口需在 1024-65535 之间。" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi
exit 0
